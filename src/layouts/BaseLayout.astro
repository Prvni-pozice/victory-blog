---
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import '../styles/global.css';
import { SITE } from '~/lib/categories';
import UtilityBar from '~/components/UtilityBar.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import Newsletter from '~/components/Newsletter.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  modDate?: Date;
  authorName?: string;
  noindex?: boolean;
  noNewsletter?: boolean;
}
const {
  title,
  description,
  ogImage = '/og-default.svg',
  canonicalURL = new URL(Astro.url.pathname, Astro.site).toString(),
  type = 'website',
  pubDate,
  modDate,
  authorName,
  noindex = false,
  noNewsletter = false,
} = Astro.props;

const fullTitle = title.includes(SITE.name) || title.includes('Victory') ? title : `${title} | ${SITE.name}`;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).toString();

// Org JSON-LD na každé stránce.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Victory Auto',
  url: SITE.mainSiteUrl,
  logo: new URL('/logo.svg', Astro.site).toString(),
  sameAs: [SITE.social.facebook, SITE.social.youtube, SITE.social.linkedin],
};
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Theme color matches utility bar -->
    <meta name="theme-color" content="#0171c0" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#0171c0" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {modDate && <meta property="article:modified_time" content={modDate.toISOString()} />}
    {authorName && <meta property="article:author" content={authorName} />}

    <!-- Feeds -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Victory Blog — RSS" href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />

    <slot name="head" />
  </head>
  <body class="grain">
    <a href="#main" class="skip-link">Přeskočit na obsah</a>
    <UtilityBar />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    {!noNewsletter && <Newsletter />}
    <SiteFooter />
  </body>
</html>
