---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Stránka nenalezena" description="Hledaná stránka neexistuje." noindex noNewsletter>
  <div class="shell" style="padding: 120px 0; text-align: center;">
    <span class="eyebrow">▌ 404</span>
    <h1 style="font-size: clamp(48px, 8vw, 96px); margin: 24px 0;">Tady to není.</h1>
    <p style="color: var(--fg-dim); max-width: 50ch; margin: 0 auto 32px;">Stránku jsme přesunuli, smazali, nebo nikdy neexistovala. Vraťte se na úvod blogu nebo prohledejte archiv.</p>
    <div style="display: inline-flex; gap: 12px;">
      <a class="btn btn-primary" href="/">Na úvod blogu</a>
      <a class="btn btn-ghost" href="/blog/hledat/">Hledat článek</a>
    </div>
  </div>
</BaseLayout>
